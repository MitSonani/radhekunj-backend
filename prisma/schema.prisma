// Prisma schema — e-commerce models will be added in future migrations.
// This file establishes the Prisma infrastructure only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar
  countryCode  String?  @map("country_code") @db.VarChar
  mobileNumber String   @unique @map("mobile_number") @db.VarChar
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  role   Role?   @relation(fields: [roleId], references: [id])
  roleId String? @db.Uuid
  cart   Cart?

  wishlistItems WishlistItem[]
  addresses     Address[]

  @@map("users")
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)

  users User[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("roles")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE

  @@map("category_status")
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @unique @db.VarChar(100)
  slug        String         @unique @db.VarChar(120)
  description String?        @db.Text
  imageKey    String?        @map("image_key") @db.VarChar(512)
  imageUrl    String?        @map("image_url") @db.VarChar(2048)
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  products Product[]

  @@index([status])
  @@map("categories")
}

model Attribute {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  values AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String   @id @default(uuid()) @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  value       String   @db.VarChar(100)
  slug        String   @db.VarChar(120)
  colorCode   String?  @map("color_code") @db.VarChar(7)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  attribute         Attribute                 @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  variantAttributes ProductVariantAttribute[]
  productImages     ProductImage[]

  @@unique([attributeId, value])
  @@unique([attributeId, slug])
  @@map("attribute_values")
}

enum ProductStatus {
  ACTIVE
  INACTIVE

  @@map("product_status")
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE

  @@map("product_variant_status")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  name        String        @db.VarChar(200)
  slug        String        @unique @db.VarChar(120)
  description String?       @db.Text
  basePrice   Decimal       @map("base_price") @db.Decimal(12, 2)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]

  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id             String               @id @default(uuid()) @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  sku            String               @unique @db.VarChar(64)
  price          Decimal              @db.Decimal(12, 2)
  compareAtPrice Decimal?             @map("compare_at_price") @db.Decimal(12, 2)
  status         ProductVariantStatus @default(ACTIVE)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  product    Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  attributes ProductVariantAttribute[]
  inventory  Inventory?
  cartItems  CartItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductVariantAttribute {
  id               String @id @default(uuid()) @db.Uuid
  variantId        String @map("variant_id") @db.Uuid
  attributeValueId String @map("attribute_value_id") @db.Uuid

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@unique([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("product_variant_attributes")
}

model Inventory {
  id               String   @id @default(uuid()) @db.Uuid
  variantId        String   @unique @map("variant_id") @db.Uuid
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

model ProductImage {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  attributeValueId String?  @map("attribute_value_id") @db.Uuid
  objectKey        String   @map("object_key") @db.VarChar(512)
  altText          String?  @map("alt_text") @db.VarChar(255)
  sortOrder        Int      @default(0) @map("sort_order")
  isPrimary        Boolean  @default(false) @map("is_primary")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([attributeValueId])
  @@map("product_images")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Wishlist
// ---------------------------------------------------------------------------

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Address
//
// Mutable customer-saved addresses (My Account, checkout selection).
// Future Order records MUST snapshot these fields at purchase time rather
// than referencing this row as the permanent delivery address.
//
// At most one default address per user is enforced by a PostgreSQL partial
// unique index created in the migration SQL (Prisma cannot express
// WHERE is_default = true in @@unique). Do not drop that index in later
// migrate-dev reviews:
//   CREATE UNIQUE INDEX "addresses_one_default_per_user_idx"
//     ON "addresses" ("user_id") WHERE "is_default" = true;
// ---------------------------------------------------------------------------

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(200)
  countryCode  String   @map("country_code") @db.VarChar(8)
  mobileNumber String   @map("mobile_number") @db.VarChar(20)
  addressLine1 String   @map("address_line_1") @db.VarChar(255)
  addressLine2 String?  @map("address_line_2") @db.VarChar(255)
  city         String   @db.VarChar(100)
  state        String   @db.VarChar(100)
  postalCode   String   @map("postal_code") @db.VarChar(20)
  country      String   @db.VarChar(100)
  /// Optional free-form label (e.g. Home, Office, Other). Not an enum so it stays extensible.
  label        String?  @db.VarChar(50)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}
