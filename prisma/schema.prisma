// Prisma schema — e-commerce models will be added in future migrations.
// This file establishes the Prisma infrastructure only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar
  countryCode  String?  @map("country_code") @db.VarChar
  mobileNumber String   @unique @map("mobile_number") @db.VarChar
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  role   Role?   @relation(fields: [roleId], references: [id])
  roleId String? @db.Uuid

  @@map("users")
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)

  users User[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("roles")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE

  @@map("category_status")
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @unique @db.VarChar(100)
  slug        String         @unique @db.VarChar(120)
  description String?        @db.Text
  imageKey    String?        @map("image_key") @db.VarChar(512)
  imageUrl    String?        @map("image_url") @db.VarChar(2048)
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@map("categories")
}

model Attribute {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  values AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String   @id @default(uuid()) @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  value       String   @db.VarChar(100)
  slug        String   @db.VarChar(120)
  colorCode   String?  @map("color_code") @db.VarChar(7)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@unique([attributeId, value])
  @@unique([attributeId, slug])
  @@map("attribute_values")
}
