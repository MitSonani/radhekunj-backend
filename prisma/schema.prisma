// Prisma schema — e-commerce models will be added in future migrations.
// This file establishes the Prisma infrastructure only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar
  countryCode  String?  @map("country_code") @db.VarChar
  mobileNumber String   @unique @map("mobile_number") @db.VarChar
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  role   Role?   @relation(fields: [roleId], references: [id])
  roleId String? @db.Uuid
  cart   Cart?

  wishlistItems WishlistItem[]
  addresses     Address[]
  couponUsages  CouponUsage[]
  orders        Order[]

  @@map("users")
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)

  users User[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("roles")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE

  @@map("category_status")
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @unique @db.VarChar(100)
  slug        String         @unique @db.VarChar(120)
  description String?        @db.Text
  imageKey    String?        @map("image_key") @db.VarChar(512)
  imageUrl    String?        @map("image_url") @db.VarChar(2048)
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  products         Product[]
  couponCategories CouponCategory[]

  @@index([status])
  @@map("categories")
}

model Attribute {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  values AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String   @id @default(uuid()) @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  value       String   @db.VarChar(100)
  slug        String   @db.VarChar(120)
  colorCode   String?  @map("color_code") @db.VarChar(7)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  attribute         Attribute                 @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  variantAttributes ProductVariantAttribute[]
  productImages     ProductImage[]

  @@unique([attributeId, value])
  @@unique([attributeId, slug])
  @@map("attribute_values")
}

enum ProductStatus {
  ACTIVE
  INACTIVE

  @@map("product_status")
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE

  @@map("product_variant_status")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  name        String        @db.VarChar(200)
  slug        String        @unique @db.VarChar(120)
  description String?       @db.Text
  basePrice   Decimal       @map("base_price") @db.Decimal(12, 2)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]

  wishlistItems  WishlistItem[]
  couponProducts CouponProduct[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id             String               @id @default(uuid()) @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  sku            String               @unique @db.VarChar(64)
  price          Decimal              @db.Decimal(12, 2)
  compareAtPrice Decimal?             @map("compare_at_price") @db.Decimal(12, 2)
  status         ProductVariantStatus @default(ACTIVE)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  product    Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  attributes ProductVariantAttribute[]
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductVariantAttribute {
  id               String @id @default(uuid()) @db.Uuid
  variantId        String @map("variant_id") @db.Uuid
  attributeValueId String @map("attribute_value_id") @db.Uuid

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@unique([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("product_variant_attributes")
}

model Inventory {
  id               String   @id @default(uuid()) @db.Uuid
  variantId        String   @unique @map("variant_id") @db.Uuid
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

model ProductImage {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  attributeValueId String?  @map("attribute_value_id") @db.Uuid
  objectKey        String   @map("object_key") @db.VarChar(512)
  altText          String?  @map("alt_text") @db.VarChar(255)
  sortOrder        Int      @default(0) @map("sort_order")
  isPrimary        Boolean  @default(false) @map("is_primary")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([attributeValueId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  couponId  String?  @map("coupon_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  CartItem[]

  @@index([couponId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Wishlist
// ---------------------------------------------------------------------------

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Address
// ---------------------------------------------------------------------------

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(200)
  countryCode  String   @map("country_code") @db.VarChar(8)
  mobileNumber String   @map("mobile_number") @db.VarChar(20)
  addressLine1 String   @map("address_line_1") @db.VarChar(255)
  addressLine2 String?  @map("address_line_2") @db.VarChar(255)
  city         String   @db.VarChar(100)
  state        String   @db.VarChar(100)
  postalCode   String   @map("postal_code") @db.VarChar(20)
  country      String   @db.VarChar(100)
  label        String?  @db.VarChar(50)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Coupons
// ---------------------------------------------------------------------------

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("coupon_discount_type")
}

enum CouponScope {
  CART
  PRODUCT
  CATEGORY

  @@map("coupon_scope")
}

enum CouponStatus {
  ACTIVE
  INACTIVE

  @@map("coupon_status")
}

model Coupon {
  id               String             @id @default(uuid()) @db.Uuid
  code             String             @unique @db.VarChar(50)
  discountType     CouponDiscountType @map("discount_type")
  discountValue    Decimal            @map("discount_value") @db.Decimal(12, 2)
  scope            CouponScope
  minimumCartValue Decimal?           @map("minimum_cart_value") @db.Decimal(12, 2)
  maximumDiscount  Decimal?           @map("maximum_discount") @db.Decimal(12, 2)
  startsAt         DateTime           @map("starts_at") @db.Timestamptz
  expiresAt        DateTime           @map("expires_at") @db.Timestamptz
  usageLimit       Int?               @map("usage_limit")
  perUserLimit     Int?               @map("per_user_limit")
  status           CouponStatus       @default(ACTIVE)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  products   CouponProduct[]
  categories CouponCategory[]
  usages     CouponUsage[]
  carts      Cart[]

  @@index([status])
  @@index([startsAt, expiresAt])
  @@map("coupons")
}

model CouponProduct {
  id        String @id @default(uuid()) @db.Uuid
  couponId  String @map("coupon_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@index([productId])
  @@map("coupon_products")
}

model CouponCategory {
  id         String @id @default(uuid()) @db.Uuid
  couponId   String @map("coupon_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
  @@index([categoryId])
  @@map("coupon_categories")
}

model CouponUsage {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  orderId        String?  @map("order_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([userId])
  @@index([couponId, userId])
  @@index([orderId])
  @@map("coupon_usages")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("order_status")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderNumber     String      @unique @map("order_number") @db.VarChar(64)
  idempotencyKey  String?     @unique @map("idempotency_key") @db.VarChar(128)
  userId          String      @map("user_id") @db.Uuid
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal        Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  shippingFee     Decimal     @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  /// Immutable snapshot of the delivery address at purchase time
  shippingAddress Json        @map("shipping_address") @db.JsonB
  expiresAt       DateTime?   @map("expires_at") @db.Timestamptz
  taxBreakdown    Json?       @map("tax_breakdown") @db.JsonB
  shippingDetails Json?       @map("shipping_details") @db.JsonB
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  couponUsages CouponUsage[]
  payments     Payment[]
  shipments    Shipment[]
  refunds      Refund[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  sku         String   @db.VarChar(64)
  productName String   @map("product_name") @db.VarChar(200)
  /// Immutable snapshot of variant attributes at purchase time (e.g. [{ name: "Size", value: "M" }])
  attributes  Json     @db.JsonB
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

enum PaymentMethod {
  COD
  RAZORPAY

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED

  @@map("payment_status")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  paymentMethod     PaymentMethod @map("payment_method")
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR") @db.VarChar(10)
  provider          String?       @db.VarChar(50)
  providerOrderId   String?       @map("provider_order_id") @db.VarChar(128)
  providerPaymentId String?       @unique @map("provider_payment_id") @db.VarChar(128)
  providerSignature String?       @map("provider_signature") @db.VarChar(255)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz
  failureReason     String?       @map("failure_reason") @db.VarChar(500)
  metadata          Json?         @db.JsonB
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([providerOrderId])
  @@index([paymentStatus])
  @@map("payments")
}


// ---------------------------------------------------------------------------
// Shipments
// ---------------------------------------------------------------------------

enum ShipmentStatus {
  NOT_BOOKED
  BOOKED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED

  @@map("shipment_status")
}

model Shipment {
  id                 String         @id @default(uuid()) @db.Uuid
  orderId            String         @map("order_id") @db.Uuid
  provider           String         @default("SHIPROCKET") @db.VarChar(50)
  status             ShipmentStatus @default(NOT_BOOKED)
  trackingNumber     String?        @map("tracking_number") @db.VarChar(100)
  providerShipmentId String?        @map("provider_shipment_id") @db.VarChar(100)
  providerOrderId    String?        @map("provider_order_id") @db.VarChar(100)
  courierName        String?        @map("courier_name") @db.VarChar(100)
  trackingUrl        String?        @map("tracking_url") @db.VarChar(500)
  bookedAt           DateTime?      @map("booked_at") @db.Timestamptz
  shippedAt          DateTime?      @map("shipped_at") @db.Timestamptz
  deliveredAt        DateTime?      @map("delivered_at") @db.Timestamptz
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@map("shipments")
}

// ---------------------------------------------------------------------------
// Refunds
// ---------------------------------------------------------------------------

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED

  @@map("refund_status")
}

model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  paymentId       String       @map("payment_id") @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  amount          Decimal      @db.Decimal(12, 2)
  currency        String       @default("INR") @db.VarChar(10)
  reason          String?      @db.VarChar(255)
  status          RefundStatus @default(PENDING)
  gatewayRefundId String?      @unique @map("gateway_refund_id") @db.VarChar(128)
  failureReason   String?      @map("failure_reason") @db.VarChar(500)
  idempotencyKey  String?      @unique @map("idempotency_key") @db.VarChar(128)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Store Settings
// ---------------------------------------------------------------------------

model StoreSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("store_settings")
}

// ---------------------------------------------------------------------------
// Homepage Hero Banners
// ---------------------------------------------------------------------------

model Banner {
  id              String   @id @default(uuid()) @db.Uuid
  title           String   @db.VarChar(255)
  subtitle        String?  @db.VarChar(500)
  badgeText       String?  @map("badge_text") @db.VarChar(100)
  ctaLabel        String?  @map("cta_label") @db.VarChar(100)
  ctaLink         String?  @map("cta_link") @db.VarChar(500)
  desktopImageUrl String   @map("desktop_image_url") @db.VarChar(1000)
  tabletImageUrl  String?  @map("tablet_image_url") @db.VarChar(1000)
  mobileImageUrl  String?  @map("mobile_image_url") @db.VarChar(1000)
  desktopImageKey String?  @map("desktop_image_key") @db.VarChar(500)
  tabletImageKey  String?  @map("tablet_image_key") @db.VarChar(500)
  mobileImageKey  String?  @map("mobile_image_key") @db.VarChar(500)
  altText         String   @map("alt_text") @db.VarChar(255)
  textAlignment   String   @default("left") @map("text_alignment") @db.VarChar(20)
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isActive, sortOrder])
  @@map("banners")
}
