# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce?schema=public

# Redis (optional — used when Redis functionality is enabled)
REDIS_URL=redis://localhost:6379

# CORS — comma-separated allowed origins
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# JWT Authentication
JWT_SECRET=your_jwt_secret_here

# AWS S3 — category and product image uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name
# Optional CloudFront or custom public base URL (no trailing slash)
# AWS_S3_PUBLIC_BASE_URL=https://cdn.example.com

# Razorpay Payment Gateway (Test mode / Production)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# MSG91 WhatsApp OTP Configuration
WHATSAPP_PROVIDER=mock
MSG91_AUTH_KEY=your_msg91_authkey_here
MSG91_INTEGRATED_NUMBER=919876543210
MSG91_WHATSAPP_TEMPLATE_NAME=otp_verification
MSG91_WHATSAPP_LANGUAGE_CODE=en

# Fast2SMS Configuration (Optional SMS fallback)
SMS_PROVIDER=mock
FAST2SMS_API_KEY=your_fast2sms_api_key_here
