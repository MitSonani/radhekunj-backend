# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce?schema=public

# Redis (optional — used when Redis functionality is enabled)
REDIS_URL=redis://localhost:6379

# CORS — comma-separated allowed origins
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# JWT Authentication
JWT_SECRET=your_jwt_secret_here

# AWS S3 — category (and future) image uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name
# Optional CloudFront or custom public base URL (no trailing slash)
# AWS_S3_PUBLIC_BASE_URL=https://cdn.example.com
